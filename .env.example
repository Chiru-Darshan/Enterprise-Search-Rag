# Copy to .env and fill in secrets. Never commit the real .env file.

# --- OpenSearch ---
OPENSEARCH_ADMIN_PASSWORD=ChangeMe_Dev123!
OPENSEARCH_INDEX=searchunify_chunks
OPENSEARCH_HEAP=512m

# --- Embeddings / Reranking (FR-05, downloaded on first container start) ---
# Dev default: small + fast on CPU (~130MB embed, ~280MB rerank), English-only.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# Production alternative: multilingual, higher accuracy, ~2.2GB each, needs a GPU
# or patience on CPU. Switching is just these two lines - dimension is read from
# the model at index-creation time, nothing else changes.
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM (FR-08 Answer/Verification agents) ---
# Default: Ollama running natively on this Windows machine (already installed,
# gemma4 already pulled) - not containerized. compose.yaml points the api
# container at it via host.docker.internal; running the api directly on the
# host uses OLLAMA_BASE_URL=http://localhost:11434 (see api/app/config.py).
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4
# Only needed if your host Ollama listens somewhere other than localhost:11434:
# OLLAMA_BASE_URL=http://localhost:11434

# Alternative: hosted Groq API (fast, free tier, needs an internet connection + key)
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
